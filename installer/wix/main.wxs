<?xml version="1.0" encoding="UTF-8"?>
<!--
  Data Exporter MSI Installer

  Build with: cargo wix -p data-exporter-installer

  Features:
  - Custom installation directory selection
  - Registry key for install path (read by service and configurator)
  - Windows service registration
  - Start Menu shortcuts
  - Default config.toml (preserved on upgrade)
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi"
     xmlns:util="http://schemas.microsoft.com/wix/UtilExtension">

  <?define ProductName = "Data Exporter" ?>
  <?define Manufacturer = "BitBi" ?>
  <!-- Version is passed via command line: -dVersion="x.y.z" -->
  <?ifndef Version ?>
    <?define Version = "1.0.0" ?>
  <?endif ?>
  <?define UpgradeCode = "E8A3D4B1-7F2C-4E5A-9B8D-1C3E5F7A9B2D" ?>

  <Product Id="*"
           Name="$(var.ProductName)"
           Language="1033"
           Version="$(var.Version)"
           Manufacturer="$(var.Manufacturer)"
           UpgradeCode="$(var.UpgradeCode)">

    <Package InstallerVersion="500"
             Compressed="yes"
             InstallScope="perMachine"
             Description="$(var.ProductName) $(var.Version)"
             Comments="Installs $(var.ProductName) service and configurator" />

    <!-- Embed files in the MSI -->
    <MediaTemplate EmbedCab="yes" />

    <!-- Major upgrade handling - removes old versions before installing new -->
    <MajorUpgrade DowngradeErrorMessage="A newer version of $(var.ProductName) is already installed."
                  Schedule="afterInstallInitialize" />

    <!-- Define the default install directory -->
    <Property Id="INSTALLFOLDER" Value="C:\Program Files\data-exporter" />

    <!-- Allow users to change install directory -->
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />

    <!-- Windows Installer UI -->
    <UIRef Id="WixUI_InstallDir" />
    <UIRef Id="WixUI_ErrorProgressText" />

    <!-- Custom install directory -->
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="data-exporter">
          <Directory Id="LogsFolder" Name="logs" />
        </Directory>
      </Directory>

      <!-- Start Menu shortcuts -->
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="Data Exporter" />
      </Directory>
    </Directory>

    <!-- Main component group -->
    <Feature Id="MainFeature"
             Title="$(var.ProductName)"
             Description="Installs the Data Exporter service and configurator"
             Level="1"
             ConfigurableDirectory="INSTALLFOLDER">

      <ComponentGroupRef Id="ProductComponents" />
      <ComponentGroupRef Id="Shortcuts" />
    </Feature>

    <!-- Product components -->
    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">

      <!-- Registry key for install path -->
      <Component Id="RegistryComponent" Guid="B1C2D3E4-F5A6-7B8C-9D0E-1F2A3B4C5D6E">
        <RegistryKey Root="HKLM" Key="SOFTWARE\DataExporter">
          <RegistryValue Name="InstallPath"
                         Type="string"
                         Value="[INSTALLFOLDER]"
                         KeyPath="yes" />
          <RegistryValue Name="Version"
                         Type="string"
                         Value="$(var.Version)" />
        </RegistryKey>
      </Component>

      <!-- Service executable -->
      <Component Id="ServiceExe" Guid="C2D3E4F5-A6B7-8C9D-0E1F-2A3B4C5D6E7F">
        <File Id="DataExporterExe"
              Name="data_exporter.exe"
              Source="$(var.CargoTargetDir)\release\data_exporter.exe"
              KeyPath="yes" />

        <!-- Windows Service registration -->
        <ServiceInstall Id="DataExporterService"
                        Name="data-exporter"
                        DisplayName="Data Exporter Service"
                        Description="Automatically exports DBF files to CSV, compresses to gzip, and uploads to cloud server"
                        Type="ownProcess"
                        Start="auto"
                        ErrorControl="normal"
                        Account="LocalSystem" />

        <ServiceControl Id="StartService"
                        Name="data-exporter"
                        Start="install"
                        Stop="both"
                        Remove="uninstall"
                        Wait="yes" />
      </Component>

      <!-- Configurator executable -->
      <Component Id="ConfiguratorExe" Guid="D3E4F5A6-B7C8-9D0E-1F2A-3B4C5D6E7F8A">
        <File Id="ConfiguratorExe"
              Name="data_exporter_configurator.exe"
              Source="$(var.CargoTargetDir)\release\data_exporter_configurator.exe"
              KeyPath="yes" />
      </Component>

      <!-- Default configuration file (never overwrite on upgrade) -->
      <Component Id="DefaultConfig" Guid="E4F5A6B7-C8D9-0E1F-2A3B-4C5D6E7F8A9B" NeverOverwrite="yes">
        <File Id="ConfigToml"
              Name="config.toml"
              Source="$(var.CargoTargetDir)\..\config.example.toml"
              KeyPath="yes" />
      </Component>

      <!-- Logs directory -->
      <Component Id="LogsDirectory" Guid="F5A6B7C8-D9E0-1F2A-3B4C-5D6E7F8A9B0C">
        <CreateFolder Directory="LogsFolder">
          <Permission User="SYSTEM" GenericAll="yes" />
          <Permission User="Administrators" GenericAll="yes" />
        </CreateFolder>
        <RemoveFolder Id="RemoveLogsFolder" Directory="LogsFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="SOFTWARE\DataExporter\Components" Name="LogsFolder" Type="integer" Value="1" KeyPath="yes" />
      </Component>

    </ComponentGroup>

    <!-- Start Menu shortcuts -->
    <ComponentGroup Id="Shortcuts" Directory="ApplicationProgramsFolder">
      <Component Id="ShortcutsComponent" Guid="A6B7C8D9-E0F1-2A3B-4C5D-6E7F8A9B0C1D">
        <Shortcut Id="ConfiguratorShortcut"
                  Name="Data Exporter Configurator"
                  Description="Configure the Data Exporter service"
                  Target="[INSTALLFOLDER]data_exporter_configurator.exe"
                  WorkingDirectory="INSTALLFOLDER" />

        <RemoveFolder Id="RemoveProgramsFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="SOFTWARE\DataExporter\Shortcuts" Name="Installed" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- Icon for Add/Remove Programs (uncomment when app.ico is available) -->
    <!-- <Icon Id="AppIcon.ico" SourceFile="$(var.CargoTargetDir)\..\installer\assets\app.ico" /> -->
    <!-- <Property Id="ARPPRODUCTICON" Value="AppIcon.ico" /> -->

    <!-- Add/Remove Programs metadata -->
    <Property Id="ARPHELPLINK" Value="https://github.com/bitbi/data-exporter" />
    <Property Id="ARPURLINFOABOUT" Value="https://bitbi.io" />

  </Product>
</Wix>
